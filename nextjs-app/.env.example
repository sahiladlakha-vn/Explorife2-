# See MIGRATION_PLAN.md §5 / README.md's "Environment variables" section for
# the full rationale behind each variable.
# Copy this file to .env.local (gitignored) and fill in real values locally;
# never commit real secrets. prisma.config.ts loads `.env` then `.env.local`
# (local wins), so `.env.local` is what both `npm run dev` and standalone
# `npx prisma <command>` actually read.

# --- Prisma / Postgres (the existing Supabase-hosted database — see §0) ----

# Transaction pooler (Supabase's PgBouncer, port 6543, `?pgbouncer=true`).
# Used by the Prisma client at runtime for all normal query traffic (the app
# itself). IPv4, good for many short-lived serverless connections, but
# transaction-mode (no prepared statements/advisory locks/LISTEN-NOTIFY) —
# that's why migrations use a different connection below.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (same pooler host, port 5432, no `pgbouncer=true`). Used
# only by `prisma migrate`/`prisma db pull`/`prisma migrate diff`, which need
# a full non-transaction-pooled session.
#
# This is NOT Supabase's literal "direct connection" host
# (`db.[project-ref].supabase.co`) — that host is IPv6-only on the free plan
# and unreachable from most networks/CI runners. The session pooler gives
# the Prisma CLI the same non-pooled-session capability over IPv4.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres"

# --- Local development database (optional) ----------------------------------
#
# For local-only work (running `prisma migrate dev`, `npx prisma db seed`,
# etc.) against a Supabase-CLI-provisioned local Postgres instead of the live
# project. See README.md's "Local development database" section for setup
# (`supabase start`). Never point the variables above (DATABASE_URL/
# DIRECT_URL) at the live project while also using these for local work —
# use ONE set or the other in a given .env.local, not both.
#
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase Auth / Storage (kept — see §0) --------------------------------

# Project URL and anon/public key, used by @supabase/ssr's browser and server
# clients (lib/supabase/client.ts, lib/supabase/server.ts) for Auth sessions
# (including anonymous/guest sign-in, §Risk 8) and Storage access.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# Service-role key — server-only, never exposed to the client. Needed for the
# Supabase Admin API calls ported from supabase/functions/admin-create-user
# (inviteUserByEmail / getUserById / deleteUser) into lib/server/admin/users.ts
# per §3a.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- Third-party services (kept — see §4) -----------------------------------

# Mapbox access token (was MAPBOX_TOKEN). No Supabase dependency.
NEXT_PUBLIC_MAPBOX_TOKEN="[mapbox-token]"

# --- App config --------------------------------------------------------------

# Base URL for Supabase Auth OAuth/invite redirects (was APP_URL). Points
# @supabase/ssr's redirect handling and the invite-email flow at this app's
# own /auth/callback route.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
