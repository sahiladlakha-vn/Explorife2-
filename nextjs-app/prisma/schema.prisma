/// `stop_id` and `trip_stops.booking_id` form a two-way nullable relationship
/// between TripBooking and TripStop (two independent FK constraints),
/// modeled via two distinct relation names on each side. `trip_stops
/// .booking_id` has a plain (non-unique) index on the live DB — NOT a unique
/// constraint — so multiple stops may reference the same booking; the
/// `"StopBooking"` relation is one-to-many (`TripBooking.stopsUsingThisBooking
/// TripStop[]`), not one-to-one.
model TripBooking {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  stopId          String?   @map("stop_id") @db.Uuid
  bookingType     String    @map("booking_type")
  title           String
  confirmationRef String?   @map("confirmation_ref")
  provider        String?
  startAt         DateTime? @map("start_at") @db.Timestamptz(6)
  endAt           DateTime? @map("end_at") @db.Timestamptz(6)
  amountVnd       BigInt?   @map("amount_vnd")
  status          String    @default("to_book")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stop          TripStop? @relation("BookingStop", fields: [stopId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdByUser User?     @relation("TripBookingCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  stopsUsingThisBooking TripStop[] @relation("StopBooking")

  @@index([stopId], map: "trip_bookings_stop_id_idx")
  @@index([tripId], map: "trip_bookings_trip_id_idx")
  @@map("trip_bookings")
  @@schema("public")
}

