// ---------------------------------------------------------------------------
// Splits (group expense-splitting)
// ---------------------------------------------------------------------------

model SplitGroup {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  currency    String    @default("USD")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  tripId      String?   @unique @map("trip_id") @db.Uuid

  creator     User?               @relation("SplitGroupCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  trip        Trip?               @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members     SplitGroupMember[]
  expenses    SplitExpense[]
  settlements SplitSettlement[]

  @@map("split_groups")
  @@schema("public")
}

model SplitGroupMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  joinedAt    DateTime? @default(now()) @map("joined_at") @db.Timestamptz(6)

  group SplitGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, userId])
  @@index([groupId], map: "split_group_members_group_id_idx")
  @@index([userId], map: "split_group_members_user_id_idx")
  @@map("split_group_members")
  @@schema("public")
}

model SplitExpense {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String?   @map("group_id") @db.Uuid
  title        String
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("USD")
  category     String?   @default("general")
  paidBy       String?   @map("paid_by") @db.Uuid
  splitType    String    @default("equal") @map("split_type")
  notes        String?
  expenseDate  DateTime? @default(dbgenerated("CURRENT_DATE")) @map("expense_date") @db.Date
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tripId       String?   @map("trip_id") @db.Uuid
  receiptUrl   String?   @map("receipt_url")
  isSettlement Boolean   @default(false) @map("is_settlement")
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  group   SplitGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payer   User?                @relation("SplitExpensePaidBy", fields: [paidBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  creator User?                @relation("SplitExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  trip    Trip?                @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shares  SplitExpenseShare[]

  @@index([groupId], map: "split_expenses_group_id_idx")
  @@index([tripId], map: "split_expenses_trip_id_idx")
  @@map("split_expenses")
  @@schema("public")
}

model SplitExpenseShare {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId String?  @map("expense_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  isSettled Boolean? @default(false) @map("is_settled")

  expense SplitExpense? @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([expenseId, userId])
  @@index([expenseId], map: "split_expense_shares_expense_id_idx")
  @@index([userId], map: "split_expense_shares_user_id_idx")
  @@map("split_expense_shares")
  @@schema("public")
}

model SplitSettlement {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String?   @map("group_id") @db.Uuid
  fromUser   String?   @map("from_user") @db.Uuid
  toUser     String?   @map("to_user") @db.Uuid
  amount     Decimal   @db.Decimal(12, 2)
  note       String?
  settledAt  DateTime? @default(now()) @map("settled_at") @db.Timestamptz(6)
  recordedBy String?   @map("recorded_by") @db.Uuid

  group    SplitGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from     User?       @relation("SplitSettlementFrom", fields: [fromUser], references: [id], onDelete: SetNull, onUpdate: NoAction)
  to       User?       @relation("SplitSettlementTo", fields: [toUser], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recorder User?       @relation("SplitSettlementRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([groupId], map: "split_settlements_group_id_idx")
  @@map("split_settlements")
  @@schema("public")
}

