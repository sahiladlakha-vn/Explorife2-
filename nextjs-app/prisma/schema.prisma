  @@schema("public")
}

// ---------------------------------------------------------------------------
// Dead/legacy tables — superseded by the `split_*` tables (trip_groups,
// trip_expenses, trip_members, trip_settlements) and by `saved_gems`/
// `gem_saves` (user_saved_gems). Confirmed to still exist on the live DB via
// `migrate diff`, so they're modeled here with exact column/constraint data
// (via Supabase MCP SQL introspection) purely so `prisma migrate
// diff`/`deploy` never try to drop them — `@@ignore` keeps them out of the
// generated Prisma Client entirely. No application code may read or write
// these models. See MIGRATION_PLAN.md §3.
// ---------------------------------------------------------------------------

model TripGroup {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  currency    String?   @default("USD")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  creator     User?            @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses    TripExpense[]
  members     TripMember[]
  settlements TripSettlement[]

  @@ignore
  @@map("trip_groups")
  @@schema("public")
}

model TripExpense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  description String?
  paidBy      String?   @map("paid_by") @db.Uuid
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  group TripGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payer User?      @relation(fields: [paidBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@ignore
  @@map("trip_expenses")
  @@schema("public")
}

model TripMember {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String?   @map("group_id") @db.Uuid
  userId   String?   @map("user_id") @db.Uuid
  joinedAt DateTime? @default(now()) @map("joined_at") @db.Timestamptz(6)

  group TripGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User?      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([groupId, userId])
  @@ignore
  @@map("trip_members")
  @@schema("public")
}

model TripSettlement {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String?   @map("group_id") @db.Uuid
  settledBy String?   @map("settled_by") @db.Uuid
  settledAt DateTime? @default(now()) @map("settled_at") @db.Timestamptz(6)

  group   TripGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  settler User?      @relation(fields: [settledBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@ignore
  @@map("trip_settlements")
  @@schema("public")
}

model UserSavedGem {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  gemId   String   @map("gem_id") @db.Uuid
  savedAt DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gem  SavedGem @relation(fields: [gemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, gemId])
  @@ignore
  @@map("user_saved_gems")
  @@schema("public")
}
